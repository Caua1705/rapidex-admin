# Base da API do Rapidex. SEM barra no final.
# Local, apontando para produção:
VITE_API_BASE_URL=https://api.pederapidex.com

# Local, apontando para o backend rodando na sua máquina:
# VITE_API_BASE_URL=http://localhost:8000

# ============================================================================
# O DOMÍNIO DO APP DO CLIENTE — de onde sai o link do entregador
# ============================================================================
#
# O painel monta `<app>/entregador/{link_token}` e entrega esse endereço ao
# motoboy. SEM BARRA no final.
#
# ELA NÃO TEM VALOR PADRÃO, DE PROPÓSITO. Faltando esta variável, o painel não
# oferece o botão de gerar acesso — porque a alternativa é gerar um link para
# um domínio errado, e o par link+código sai UMA VEZ SÓ: o motoboy receberia
# algo que não abre, e a segunda via mata a primeira.
#
# VITE_COURIER_APP_URL=https://pederapidex.com
